# Copy to .env.local (development) or .env (docker compose). See INSTALL.md.

# The key you type once per device to unlock the app. Long and random:
#   openssl rand -base64 36
STUDIO_ACCESS_KEY="replace-with-a-long-random-key"

# Storage: where books and study data live. Pick one.
# A folder (Docker: /data; development: ./data)
STORAGE=filesystem
STORAGE_DIR=./data
# Vercel Blob: connect a private store; Vercel sets BLOB_READ_WRITE_TOKEN.
# STORAGE=vercel-blob
# An S3-compatible bucket (Cloudflare R2, Backblaze B2, MinIO, AWS)
# STORAGE=s3
# S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
# S3_BUCKET="inkbeacon"
# S3_ACCESS_KEY_ID="…"
# S3_SECRET_ACCESS_KEY="…"
# S3_REGION=auto
# S3_VIRTUAL_HOSTED=false

# Your public address, for link previews (optional)
# SITE_URL="https://books.example.com"

# Optional: KOReader support (OPDS catalogue + progress sync). Leave unset to
# keep it off. A password of its own: it unlocks nothing else.
# KOREADER_PASSWORD="replace-with-a-long-random-password"
